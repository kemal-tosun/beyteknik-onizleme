# BeyTeknik - araclar/seo_sayfalar.py uretir. Elle degistirme, scripti duzenle.
Options -Indexes
DirectoryIndex index.html index.php
AddDefaultCharset UTF-8
RewriteEngine On

# HTTPS ve www'suz tek adres (SSL acik)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://beyteknik.com%{REQUEST_URI} [L,R=301]

# firmanin erp klasorleri: asagidaki kurallar bunlara dokunmaz
RewriteRule ^erp2?(/|$) - [L]

# yedek ve calisma dosyalari disariya kapali
RewriteRule (^|/)[^/]*_(yedek|oncesi)[^/]*$ - [R=404,L]
RewriteRule ^(araclar|belge)(/|$) - [R=404,L]
RewriteRule ^efektler\.html$ - [R=404,L]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# eski sitenin adresleri (Google'daki siralama korunur)
RewriteRule ^duyuru/[^/]+/(urun|urunler)/(.+)$ /$1/$2 [R=301,L]
RewriteRule ^duyuru/ / [R=301,L]
RewriteRule ^(index|anasayfa)/?$ / [R=301,L]
RewriteRule ^hakkimizda/?$ /hakkimizda.html [R=301,L]
RewriteRule ^kalite/?$ /#uretim [R=301,L,NE]
RewriteRule ^(iletisim|bayilerimiz)/?$ /#teklif [R=301,L,NE]
RewriteRule ^(referanslar|referans/.*)$ /#referanslar [R=301,L,NE]
RewriteRule ^urun-kategorileri/?$ /#urunler [R=301,L,NE]
RewriteRule ^(urun|urunler)/([^/]+)/en/?$ /$1/$2/ [R=301,L]
RewriteRule ^urun/led\-gunes\-enerjili\-aydinlatma\-diregi\-sl\-4010/?(en)?/?$ /#katalog [R=301,L,NE]
RewriteRule ^urun/led\-gunes\-enerjili\-aydinlatma\-diregi\-sl\-4020/?(en)?/?$ /#katalog [R=301,L,NE]
RewriteRule ^urun/led\-gunes\-enerjili\-aydinlatma\-diregi\-sl\-4030/?(en)?/?$ /#katalog [R=301,L,NE]
RewriteRule ^urun/sl101/?(en)?/?$ /#katalog [R=301,L,NE]
RewriteRule ^urun/sl103/?(en)?/?$ /#katalog [R=301,L,NE]
RewriteRule ^urun/sl104/?(en)?/?$ /#katalog [R=301,L,NE]
