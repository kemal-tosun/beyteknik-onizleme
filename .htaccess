RewriteRule ^urun/sl121/?(en)?/?$ /#katalog [R=301,L,NE]
RewriteRule ^urun/sl122/?(en)?/?$ /#katalog [R=301,L,NE]
RewriteRule ^urun/sl123/?(en)?/?$ /#katalog [R=301,L,NE]
RewriteRule ^urun/sl124/?(en)?/?$ /#katalog [R=301,L,NE]
RewriteRule ^urun/sl125/?(en)?/?$ /#katalog [R=301,L,NE]
RewriteRule ^urun/sl127/?(en)?/?$ /#katalog [R=301,L,NE]
RewriteRule ^urun/sl128/?(en)?/?$ /#katalog [R=301,L,NE]
RewriteRule ^urun/sl129/?(en)?/?$ /#katalog [R=301,L,NE]
